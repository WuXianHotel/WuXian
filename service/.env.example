# ─── 服务 ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 数据库 ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=hotel_miniprogram
DB_POOL_LIMIT=10

# ─── JWT ─────────────────────────────────────────────
# 小程序用户 Token（较长有效期）
MP_JWT_SECRET=mp_secret_change_me_in_production
MP_JWT_EXPIRES_IN=7d

# 后台管理员 Token（较短有效期）
ADMIN_JWT_SECRET=admin_secret_change_me_in_production
ADMIN_JWT_EXPIRES_IN=8h

# ─── 微信小程序 ───────────────────────────────────────
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# ─── 微信支付 ─────────────────────────────────────────
WX_MCH_ID=your_mch_id
WX_API_KEY=your_api_key_v3
WX_NOTIFY_URL=https://yourdomain.com/api/mp/pay/notify

# ─── 文件上传 ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─── 允许跨域的前端地址（生产环境必填，逗号分隔）──────
ALLOWED_ORIGINS=https://your-admin.vercel.app

# ─── 日志 ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─── Mock 开关（仅在 NODE_ENV != production 时生效） ───────────────
# 生产环境（NODE_ENV=production）下，所有 mock 被强制关闭，下列开关无效。
# 本地开发保持默认 true 即可；要测真实微信/支付链路时把对应项置 false。
MOCK_ENABLED=true          # 总开关。false=一键关闭所有 mock
MOCK_WX_LOGIN=true         # 微信登录：跳过 code2Session，用 code 哈希当假 openid
MOCK_WX_PAY=true           # 微信支付：/pay/create 返回 mock 参数（前端据此走 mock-paid 流程）
MOCK_PAID_ENDPOINT=true    # 是否暴露 /pay/mock-paid（一键把订单标为已支付）
