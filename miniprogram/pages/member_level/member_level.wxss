/* pages/member_level/member_level.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── 当前等级卡 ─── */
.current-card {
  padding: 48rpx 32rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
  color: #fff;
}
.current-icon { font-size: 80rpx; margin-bottom: 12rpx; }
.current-name { font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx; }
.current-info { display: flex; gap: 12rpx; font-size: 24rpx; opacity: 0.85; }

.content { padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx); }

/* ─── 等级进度 ─── */
.progress-section { margin: 20rpx 24rpx; padding: 24rpx; }
.progress-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 24rpx; }

.level-timeline { padding-left: 8rpx; }
.timeline-item { display: flex; align-items: flex-start; gap: 20rpx; position: relative; padding-bottom: 32rpx; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #e0e0e0; color: #999; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; z-index: 1;
}
.timeline-item.reached .timeline-dot { color: #fff; }
.timeline-info { flex: 1; padding-top: 4rpx; }
.timeline-name { font-size: 28rpx; color: #1a1a1a; display: flex; align-items: center; gap: 10rpx; }
.current-tag {
  background: #ff4d4f; color: #fff; font-size: 18rpx;
  padding: 2rpx 10rpx; border-radius: 6rpx; font-weight: 600;
}
.timeline-cond { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.timeline-line {
  position: absolute; left: 23rpx; top: 48rpx; width: 2rpx;
  height: calc(100% - 48rpx); background: #e0e0e0;
}

/* ─── 权益对比表 ─── */
.benefits-section { margin: 0 24rpx 20rpx; padding: 24rpx; }
.benefit-table { overflow-x: auto; }
.bt-header, .bt-row { display: flex; }
.bt-header { border-bottom: 2rpx solid #f0e6c0; padding-bottom: 12rpx; margin-bottom: 8rpx; }
.bt-row { border-bottom: 1rpx solid #f5f5f5; }
.bt-row:last-child { border-bottom: none; }
.bt-cell {
  flex: 1; min-width: 100rpx; text-align: center;
  padding: 14rpx 4rpx; font-size: 24rpx; color: #666;
}
.bt-label {
  flex: none; width: 140rpx; text-align: left;
  font-weight: 600; color: #1a1a1a;
}
.bt-lv-icon { font-size: 28rpx; }
.bt-val { font-size: 24rpx; }
.bt-val.highlight { color: #b8860b; font-weight: 700; }
.bt-val.muted { color: #ccc; }

/* ─── 升级提示 ─── */
.upgrade-card { margin: 0 24rpx 20rpx; padding: 24rpx; }
.upgrade-title { font-size: 28rpx; font-weight: 700; color: #7a5f00; margin-bottom: 16rpx; }
.upgrade-item {
  display: flex; align-items: flex-start; gap: 10rpx;
  font-size: 24rpx; color: #666; line-height: 1.6; margin-bottom: 12rpx;
}
.upgrade-icon { font-size: 28rpx; flex-shrink: 0; }
.upgrade-hint { font-size: 22rpx; color: #999; margin-top: 8rpx; }
