/* pages/wallet/wallet.wxss */
.page { background: #f7f7f7; min-height: 100vh; }
.nav-bar { background: #1a56db; display: flex; align-items: center; padding: 16rpx 24rpx; position: relative; }
.nav-back { color: #fff; font-size: 48rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.nav-title { position: absolute; left: 50%; transform: translateX(-50%); color: #fff; font-size: 32rpx; font-weight: 600; }

.balance-card {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  margin: 20rpx 24rpx; padding: 40rpx 32rpx; border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center;
}
.balance-label { font-size: 26rpx; color: rgba(255,255,255,0.75); margin-bottom: 12rpx; }
.balance-amount { font-size: 64rpx; font-weight: 700; color: #fff; }

.content { padding: 0 24rpx; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }

.recharge-card { margin-bottom: 20rpx; padding: 24rpx; }
.quick-amounts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.quick-btn {
  text-align: center; padding: 16rpx 0; border-radius: 12rpx;
  background: #f0f5ff; color: #1a56db; font-size: 30rpx; font-weight: 600;
}
.quick-btn.active { background: #1a56db; color: #fff; }

.amount-input-row { display: flex; align-items: center; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 16rpx; margin-bottom: 24rpx; }
.amount-prefix { font-size: 36rpx; font-weight: 700; color: #1a1a1a; margin-right: 8rpx; }
.amount-input { flex: 1; font-size: 32rpx; color: #1a1a1a; }

.logs-card { padding: 24rpx; }
.log-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.log-item:last-child { border-bottom: none; }
.log-left { display: flex; flex-direction: column; gap: 6rpx; }
.log-type { font-size: 28rpx; color: #1a1a1a; }
.log-date { font-size: 22rpx; color: #999; }
.log-amount { font-size: 30rpx; font-weight: 600; }
.log-amount.add { color: #10b981; }
.log-amount.use { color: #ef4444; }

.empty-tip, .loading-tip { text-align: center; padding: 40rpx; font-size: 26rpx; color: #999; }
