<!-- pages/wallet/wallet.wxml -->
<view class="page">
  <!-- 余额卡片 -->
  <view class="balance-card">
    <text class="balance-label">账户余额（元）</text>
    <text class="balance-amount">{{balance}}</text>
  </view>

  <scroll-view scroll-y class="content safe-bottom" bindscrolltolower="loadMore">
    <!-- 充值区域 -->
    <view class="recharge-card card">
      <view class="section-title">充值</view>
      <view class="quick-amounts">
        <view class="quick-btn {{rechargeAmount == '100' ? 'active' : ''}}" bindtap="quickAmount" data-amount="100">100</view>
        <view class="quick-btn {{rechargeAmount == '300' ? 'active' : ''}}" bindtap="quickAmount" data-amount="300">300</view>
        <view class="quick-btn {{rechargeAmount == '500' ? 'active' : ''}}" bindtap="quickAmount" data-amount="500">500</view>
        <view class="quick-btn {{rechargeAmount == '1000' ? 'active' : ''}}" bindtap="quickAmount" data-amount="1000">1000</view>
      </view>
      <view class="amount-input-row">
        <input class="amount-input" type="digit" value="{{rechargeAmount}}" placeholder="输入自定义金额" bindinput="onAmountInput"/>
      </view>
      <view class="btn btn-primary btn-block {{recharging?'disabled':''}}" bindtap="doRecharge">
        {{recharging ? '充值中...' : '立即充值'}}
      </view>
    </view>

    <!-- 流水记录 -->
    <view class="logs-card card">
      <view class="section-title">交易记录</view>
      <view class="log-item" wx:for="{{logs}}" wx:key="id">
        <view class="log-left">
          <text class="log-type">{{item.remark || item.type}}</text>
          <text class="log-date">{{item.created_at}}</text>
        </view>
        <text class="log-amount {{item.amount > 0 ? 'add' : 'use'}}">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text>
      </view>
      <view wx:if="{{!logs.length && !loading}}" class="empty-tip">暂无交易记录</view>
      <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
      <view wx:if="{{noMore && logs.length}}" class="loading-tip">没有更多了</view>
    </view>
  </scroll-view>
</view>
