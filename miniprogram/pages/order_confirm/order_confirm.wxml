<!-- pages/order_confirm/order_confirm.wxml -->
<view class="page">
  <!-- 步骤 -->
  <view class="steps">
    <view class="step done">
      <view class="step-circle">✓</view>
      <text class="step-label">选择房型</text>
    </view>
    <view class="step-line done"></view>
    <view class="step done">
      <view class="step-circle">✓</view>
      <text class="step-label">填写信息</text>
    </view>
    <view class="step-line done"></view>
    <view class="step active">
      <view class="step-circle">3</view>
      <text class="step-label">确认支付</text>
    </view>
  </view>

  <scroll-view scroll-y class="content safe-bottom">
    <!-- 订单详情 -->
    <view class="detail-card card">
      <view class="detail-title"><text class="iconfont icon-file-text"></text> 订单信息</view>
      <view class="detail-row">
        <text class="row-label">房型</text>
        <text class="row-val">{{order.roomName}} × {{order.qty}}</text>
      </view>
      <view class="detail-row">
        <text class="row-label">入住时间</text>
        <text class="row-val">{{checkInDisplay}}</text>
      </view>
      <view class="detail-row">
        <text class="row-label">退房时间</text>
        <text class="row-val">{{checkOutDisplay}}</text>
      </view>
      <view class="detail-row">
        <text class="row-label">入住人</text>
        <view class="row-val">
          <view wx:for="{{guests}}" wx:key="index" class="guest-line">
            {{item.name}} · {{item.maskedPhone}}
          </view>
        </view>
      </view>
      <view class="detail-row" wx:if="{{order.remark}}">
        <text class="row-label">特殊要求</text>
        <text class="row-val remark">{{order.remark}}</text>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="fee-card card">
      <view class="detail-title"><text class="iconfont icon-wallet"></text> 费用明细</view>
      <view class="fee-row">
        <text class="fee-label">{{order.roomName}} × {{order.nights}}晚 × {{order.qty}}间</text>
        <text class="fee-val">¥{{roomTotal}}</text>
      </view>
      <view class="fee-row">
        <text class="fee-label">服务费</text>
        <text class="fee-val">¥0</text>
      </view>
      <view class="fee-row discount" wx:if="{{discountAmount > 0}}">
        <text class="fee-label">会员折扣({{order.memberDiscount}}折)</text>
        <text class="fee-val green">-¥{{discountAmount}}</text>
      </view>
      <view class="fee-row discount" wx:if="{{selectedCoupon}}">
        <text class="fee-label">优惠券</text>
        <text class="fee-val green">-¥{{selectedCoupon.discount}}</text>
      </view>
      <view class="fee-row discount" wx:if="{{usePointsDeduct && pointsDeductAmount > 0}}">
        <text class="fee-label">积分抵扣</text>
        <text class="fee-val green">-¥{{pointsDeductAmount}}</text>
      </view>
      <view class="fee-divider"></view>
      <view class="fee-row total">
        <text class="fee-label total-label">实付金额</text>
        <text class="fee-val total-val">¥{{finalPrice}}</text>
      </view>
    </view>

    <!-- 优惠券 -->
    <view class="coupon-card card" bindtap="chooseCoupon">
      <view wx:if="{{selectedCoupon}}">
        <text class="coupon-text">已使用：{{selectedCoupon.name}}</text>
        <text class="coupon-change">更换 ›</text>
      </view>
      <view wx:else class="coupon-empty">
        <text class="coupon-text coupon-none">{{coupons.length > 0 ? '点击选择优惠券' : '暂无可用优惠券'}}</text>
        <text class="coupon-change" wx:if="{{coupons.length > 0}}">选择 ›</text>
      </view>
    </view>

    <!-- 积分抵扣 -->
    <view class="points-deduct-card card" wx:if="{{deductInfo && deductInfo.enabled && deductInfo.points > 0}}">
      <view class="points-deduct-row" bindtap="togglePointsDeduct">
        <view class="points-deduct-left">
          <text class="points-deduct-label">积分抵扣</text>
          <text class="points-deduct-hint">可用 {{deductInfo.points}} 积分，最多抵扣 ¥{{deductInfo.maxDeduct}}</text>
        </view>
        <switch checked="{{usePointsDeduct}}" color="#1a56db"/>
      </view>
    </view>

    <!-- 支付方式 -->
    <view class="pay-card card">
      <view class="pay-item active">
        <view class="pay-icon"><text class="iconfont icon-wallet"></text></view>
        <text class="pay-name">会员余额支付</text>
        <text class="pay-balance">¥{{walletBalance}}</text>
      </view>
      <view class="pay-insufficient" wx:if="{{!balanceEnough && finalPrice > 0}}">
        余额不足，还差 ¥{{finalPrice - walletBalance}}，请联系前台充值
      </view>
    </view>
  </scroll-view>

  <!-- 底部 -->
  <view class="bottom-bar">
    <view class="total-price">
      <text class="total-label">实付</text>
      <text class="total-val">¥{{finalPrice}}</text>
    </view>
    <view class="btn btn-primary pay-btn {{paying || !balanceEnough ?'disabled':''}}" bindtap="doPay">
      {{paying ? '支付中...' : balanceEnough ? '余额支付' : '余额不足'}}
    </view>
  </view>

  <!-- 优惠券选择弹窗 -->
  <view class="modal-mask" wx:if="{{showCouponModal}}" bindtap="closeCouponModal">
    <view class="coupon-modal" catchtap="noop">
      <view class="modal-title">选择优惠券</view>
      <view wx:if="{{coupons.length === 0}}" class="empty">
        <text class="iconfont icon-tag empty-icon"></text>
        <text class="empty-text">暂无可用优惠券</text>
      </view>
      <view class="coupon-item" wx:for="{{coupons}}" wx:key="id" bindtap="selectCoupon" data-coupon="{{item}}">
        <view class="coupon-left">
          <text class="coupon-amount">¥{{item.discount}}</text>
          <text class="coupon-cond">满{{item.minAmount}}可用</text>
        </view>
        <view class="coupon-right">
          <text class="coupon-name">{{item.name}}</text>
          <text class="coupon-expire">有效期至 {{item.expireDate}}</text>
        </view>
        <view class="coupon-check" wx:if="{{selectedCoupon && selectedCoupon.id === item.id}}">✓</view>
      </view>
      <view class="coupon-no-use btn btn-gray btn-block" bindtap="noUseCoupon">不使用优惠券</view>
    </view>
  </view>
</view>
