/* pages/order_confirm/order_confirm.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

.steps { background: #fff; display: flex; align-items: center; justify-content: center; padding: 24rpx 0; }
.step { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.step-circle { width: 56rpx; height: 56rpx; border-radius: 50%; background: #f0f0f0; color: #999; font-size: 26rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; }
.step.active .step-circle { background: #1a56db; color: #fff; box-shadow: 0 0 0 6rpx rgba(26,86,219,0.2); }
.step.done .step-circle { background: #1a56db; color: #fff; }
.step-label { font-size: 22rpx; color: #999; }
.step.active .step-label, .step.done .step-label { color: #1a56db; }
.step-line { width: 80rpx; height: 2rpx; background: #e0e0e0; margin: 0 8rpx; margin-bottom: 24rpx; }
.step-line.done { background: #1a56db; }

.content { height: calc(100vh - 140px); }

/* ─── 详情卡 ─── */
.detail-card { margin: 20rpx 24rpx; padding: 24rpx; }
.detail-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.detail-row { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.detail-row:last-child { border-bottom: none; }
.row-label { font-size: 26rpx; color: #999; width: 160rpx; flex-shrink: 0; }
.row-val { font-size: 26rpx; color: #1a1a1a; flex: 1; }
.row-val.remark { color: #666; line-height: 1.5; }

/* ─── 费用 ─── */
.fee-card { margin: 0 24rpx 20rpx; padding: 24rpx; }
.fee-row { display: flex; justify-content: space-between; padding: 10rpx 0; }
.fee-label { font-size: 26rpx; color: #666; }
.fee-val { font-size: 26rpx; color: #1a1a1a; }
.fee-val.green { color: #52c41a; }
.fee-divider { height: 1rpx; background: #f0f0f0; margin: 12rpx 0; }
.fee-row.total .fee-label { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.fee-row.total .fee-val { font-size: 36rpx; font-weight: 700; color: #ff4d4f; }

/* ─── 支付方式 ─── */
.pay-card { margin: 0 24rpx 20rpx; padding: 20rpx 24rpx; }
.pay-item { display: flex; align-items: center; gap: 16rpx; }
.pay-icon { font-size: 40rpx; }
.pay-name { font-size: 28rpx; flex: 1; }
.pay-balance { font-size: 28rpx; font-weight: 700; color: #1a56db; }
.pay-insufficient { margin-top: 16rpx; padding: 16rpx; background: #fff0f0; border-radius: 8rpx; color: #ff4d4f; font-size: 24rpx; text-align: center; }

/* ─── 底部 ─── */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 20rpx 32rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 10px); display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #f0f0f0; }
.total-price { display: flex; align-items: baseline; gap: 8rpx; }
.total-label { font-size: 26rpx; color: #666; }
.total-val { font-size: 44rpx; font-weight: 700; color: #ff4d4f; }
.pay-btn { font-size: 30rpx; padding: 20rpx 60rpx; }
.pay-btn.disabled { background: #ccc; }

/* ─── 多入住人 ─── */
.guest-line { line-height: 1.8; }

/* ─── 积分抵扣 ─── */
.points-deduct-card { margin: 0 24rpx 20rpx; padding: 20rpx 24rpx; }
.points-deduct-row { display: flex; align-items: center; justify-content: space-between; }
.points-deduct-left { display: flex; flex-direction: column; gap: 6rpx; }
.points-deduct-label { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.points-deduct-hint { font-size: 22rpx; color: #999; }
