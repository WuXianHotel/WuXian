<!-- pages/member/member.wxml -->
<view class="page">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-avatar"><text class="iconfont {{memberInfo.icon ? '' : 'icon-user'}}">{{memberInfo.icon || ''}}</text></view>
    <view class="hero-name">{{userInfo.nickname || '会员用户'}}</view>
    <view class="hero-level" bindtap="goLevelProgress">
      {{memberInfo.level_name || '会员'}} ›
    </view>
  </view>

  <scroll-view scroll-y class="content safe-bottom">
    <!-- 三栏统计 -->
    <view class="stats-card">
      <view class="stat-item" bindtap="goWallet">
        <text class="stat-num">¥{{walletBalance}}</text>
        <text class="stat-label">账户余额</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{memberInfo.points || 0}}</text>
        <text class="stat-label">可用积分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goLevelProgress">
        <text class="stat-num">{{memberInfo.total_nights || 0}}<text class="stat-unit">晚</text></text>
        <text class="stat-label">累计入住</text>
      </view>
    </view>

    <!-- 升级进度入口 -->
    <view class="level-entry card" bindtap="goLevelProgress">
      <view class="level-entry-left">
        <view class="level-entry-title">{{memberInfo.level_name || '会员'}}</view>
        <view class="level-entry-sub" wx:if="{{memberInfo.next_level_name}}">
          距 {{memberInfo.next_level_name}} 还需入住 {{(memberInfo.next_min_nights || 0) - (memberInfo.total_nights || 0)}}晚
        </view>
        <view class="level-entry-sub" wx:else>已达最高等级</view>
      </view>
      <view class="level-entry-right">
        <view class="level-progress-bar-wrap">
          <view class="level-progress-bar" style="width:{{levelProgressPct}}%"></view>
        </view>
        <text class="level-entry-arrow">查看等级权益 ›</text>
      </view>
    </view>

    <!-- 快捷功能 -->
    <view class="quick-row">
      <view class="quick-btn" bindtap="goWallet">
        <text class="iconfont icon-wallet quick-icon"></text>
        <text class="quick-text">我的余额</text>
      </view>
      <view class="quick-btn" bindtap="goPointsMall">
        <text class="iconfont icon-shopping quick-icon"></text>
        <text class="quick-text">积分商城</text>
      </view>
      <view class="quick-btn" bindtap="goCoupons">
        <text class="iconfont icon-tag quick-icon"></text>
        <text class="quick-text">优惠券</text>
      </view>
      <view class="quick-btn" bindtap="goLevelProgress">
        <text class="iconfont icon-crown quick-icon"></text>
        <text class="quick-text">等级权益</text>
      </view>
    </view>

    <!-- Tab 切换：积分明细 / 余额明细 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab==='points'?'active':''}}" bindtap="switchTab" data-tab="points">积分明细</view>
      <view class="tab-item {{activeTab==='wallet'?'active':''}}" bindtap="switchTab" data-tab="wallet">余额明细</view>
    </view>

    <!-- 积分明细 -->
    <view class="log-list card" wx:if="{{activeTab==='points'}}">
      <view class="log-item" wx:for="{{pointsHistory}}" wx:key="id">
        <view class="log-left">
          <text class="log-name">{{item.remark || item.type}}</text>
          <text class="log-date">{{item.created_at}}</text>
        </view>
        <text class="log-amount {{item.points > 0 ? 'add' : 'use'}}">{{item.points > 0 ? '+' : ''}}{{item.points}}</text>
      </view>
      <view class="log-empty" wx:if="{{!pointsHistory.length}}">暂无积分记录</view>
    </view>

    <!-- 余额明细 -->
    <view class="log-list card" wx:if="{{activeTab==='wallet'}}">
      <view class="log-item" wx:for="{{walletHistory}}" wx:key="id">
        <view class="log-left">
          <text class="log-name">{{item.remark || item.type}}</text>
          <text class="log-date">{{item.created_at}}</text>
        </view>
        <text class="log-amount {{item.amount >= 0 ? 'add' : 'use'}}">{{item.amount >= 0 ? '+' : ''}}{{item.amount}}</text>
      </view>
      <view class="log-empty" wx:if="{{!walletHistory.length}}">暂无余额记录</view>
    </view>
  </scroll-view>
</view>
