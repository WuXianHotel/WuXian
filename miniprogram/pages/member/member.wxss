/* pages/member/member.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── Hero ─── */
.hero {
  background: linear-gradient(135deg, #b8860b, #ffd700, #b8860b);
  padding: 48rpx 32rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
  position: relative; min-height: 260rpx; justify-content: center;
}
.hero-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255,255,255,0.3); border: 4rpx solid rgba(255,255,255,0.6);
  font-size: 60rpx; display: flex; align-items: center; justify-content: center;
  margin-bottom: 16rpx;
}
.hero-name { font-size: 36rpx; font-weight: 700; color: #5a3a00; margin-bottom: 8rpx; }
.hero-level {
  background: rgba(90,58,0,0.15); color: #5a3a00;
  font-size: 26rpx; padding: 6rpx 24rpx; border-radius: 20rpx;
}

/* ─── 统计 ─── */
.stats-card {
  background: linear-gradient(to right, #fdf6e3, #fffbf0);
  display: flex; padding: 28rpx 0;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-num { font-size: 36rpx; font-weight: 700; color: #7a5f00; }
.stat-unit { font-size: 24rpx; }
.stat-label { font-size: 22rpx; color: #a08040; }
.stat-divider { width: 1rpx; background: #e8d48a; margin: 8rpx 0; }

/* ─── 等级进度入口 ─── */
.level-entry {
  margin: 20rpx 24rpx; padding: 24rpx;
  display: flex; align-items: center; gap: 20rpx;
}
.level-entry-left { flex-shrink: 0; }
.level-entry-title { font-size: 30rpx; font-weight: 700; color: #7a5f00; margin-bottom: 6rpx; }
.level-entry-sub { font-size: 24rpx; color: #a08040; }
.level-entry-right { flex: 1; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.level-progress-bar-wrap {
  width: 100%; height: 12rpx; background: #f0e6c0; border-radius: 6rpx; overflow: hidden;
}
.level-progress-bar {
  height: 100%; background: linear-gradient(to right, #ffd700, #b8860b); border-radius: 6rpx;
}
.level-entry-arrow { font-size: 22rpx; color: #1a56db; }

/* ─── 快捷功能 ─── */
.quick-row {
  display: flex; margin: 0 24rpx 20rpx; gap: 16rpx;
}
.quick-btn {
  flex: 1; background: #fff; border-radius: 12rpx;
  padding: 20rpx 0; display: flex; flex-direction: column;
  align-items: center; gap: 8rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.quick-icon { font-size: 36rpx; }
.quick-text { font-size: 22rpx; color: #666; }

/* ─── Tab 切换 ─── */
.tab-bar {
  display: flex; margin: 0 24rpx; background: #fff; border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
}
.tab-item {
  flex: 1; text-align: center; padding: 20rpx 0;
  font-size: 28rpx; color: #999; position: relative;
}
.tab-item.active {
  color: #7a5f00; font-weight: 700;
}
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 60rpx; height: 4rpx;
  background: #b8860b; border-radius: 2rpx;
}

/* ─── 明细列表 ─── */
.log-list { margin: 0 24rpx 20rpx; padding: 0 24rpx; border-radius: 0 0 12rpx 12rpx; }
.log-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.log-item:last-child { border-bottom: none; }
.log-left { display: flex; flex-direction: column; gap: 4rpx; }
.log-name { font-size: 26rpx; color: #1a1a1a; }
.log-date { font-size: 22rpx; color: #999; }
.log-amount { font-size: 30rpx; font-weight: 700; }
.log-amount.add { color: #52c41a; }
.log-amount.use { color: #ff4d4f; }
.log-empty { text-align: center; padding: 40rpx 0; color: #999; font-size: 26rpx; }
