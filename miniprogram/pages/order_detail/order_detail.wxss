/* pages/order_detail/order_detail.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── 状态Banner ─── */
.status-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  min-height: 240rpx;
}
.status-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.status-text { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 12rpx; }
.status-hint { font-size: 26rpx; color: rgba(255,255,255,0.85); }

.content { height: calc(100vh - 120px); }

/* ─── 二维码卡片 ─── */
.qr-card {
  margin: 20rpx 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.qr-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.qr-wrap {
  width: 240rpx; height: 240rpx;
  border: 4rpx solid #1a56db;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-img { width: 240rpx; height: 240rpx; }
.qr-placeholder {
  width: 100%; height: 100%;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-text { color: #fff; font-size: 20rpx; padding: 8rpx; text-align: center; word-break: break-all; }
.qr-hint { font-size: 24rpx; color: #666; }
.qr-no { font-size: 22rpx; color: #999; font-family: monospace; }

/* ─── 信息卡 ─── */
.info-card { margin: 0 24rpx 20rpx; padding: 24rpx; }
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.info-row { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 26rpx; color: #999; width: 160rpx; flex-shrink: 0; }
.info-val { font-size: 26rpx; color: #1a1a1a; flex: 1; }
.info-val.price { color: #ff4d4f; font-weight: 700; }

/* ─── 评价 ─── */
.review-card { margin: 0 24rpx 20rpx; padding: 24rpx; }
.star-row { display: flex; align-items: center; gap: 24rpx; margin-bottom: 20rpx; }
.star-label { font-size: 28rpx; color: #666; }
.stars-select { display: flex; gap: 8rpx; }
.star-item { font-size: 44rpx; color: #e0e0e0; }
.star-item.active { color: #faad14; }
.review-textarea {
  width: 100%; height: 160rpx;
  font-size: 28rpx; color: #333;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}
.review-done { margin: 0 24rpx 20rpx; padding: 32rpx; text-align: center; font-size: 28rpx; color: #52c41a; }

/* ─── 底部 ─── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 10px);
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action-btn { flex: 1; text-align: center; border-radius: 12rpx; }

/* ─── 多入住人 ─── */
.guest-line { line-height: 1.8; }
