/* pages/index/index.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── 全屏 loading（遮盖层，始终在 DOM 中） ─── */
.launch-loading {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a56db 0%, #3b82f6 100%);
  z-index: 9999;
}
.launch-loading[hidden] {
  display: none;
}
.launch-loading-icon {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.dot-bounce {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.85);
  animation: dot-bounce 1.2s ease-in-out infinite both;
}
@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(.5); opacity: .4; }
  40% { transform: scale(1); opacity: 1; }
}
.launch-loading-text {
  font-size: 28rpx;
  color: rgba(255,255,255,.65);
  letter-spacing: 2rpx;
}

/* ─── 头部 ─── */
.header {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  padding: 24rpx 32rpx 32rpx;
}
.header-slogan {
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.search-box {
  background: rgba(255,255,255,0.2);
  border-radius: 40rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.search-icon { font-size: 28rpx; color: rgba(255,255,255,0.8); }
.search-placeholder { color: rgba(255,255,255,0.8); font-size: 28rpx; }

.date-chips { display: flex; align-items: center; gap: 12rpx; }
.date-chip {
  background: rgba(255,255,255,0.25);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.chip-label { color: rgba(255,255,255,0.7); font-size: 22rpx; }
.chip-date { color: #fff; font-size: 28rpx; font-weight: 600; margin-top: 2rpx; }
.date-arrow { color: rgba(255,255,255,0.7); font-size: 28rpx; }
.nights-badge {
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* ─── 内容区 ─── */
.content { height: calc(100vh - 140rpx); }

/* ─── 欢迎提示 + 导航 ─── */
.welcome-bar {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.welcome-top {
  display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx;
}
.welcome-icon { font-size: 28rpx; }
.welcome-text { font-size: 26rpx; color: #7a5f00; flex: 1; }
.welcome-bottom {
  display: flex; align-items: center; justify-content: space-between;
  background: #f8fafc; border-radius: 12rpx; padding: 16rpx 20rpx;
}
.welcome-address {
  display: flex; align-items: flex-start; gap: 6rpx; flex: 1; margin-right: 16rpx;
}
.address-icon { font-size: 26rpx; flex-shrink: 0; margin-top: 2rpx; }
.address-text { font-size: 24rpx; color: #666; line-height: 1.5; }
.welcome-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.welcome-btn {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 24rpx;
  font-weight: 500;
}
.nav-btn { background: #1a56db; color: #fff; }
.call-btn { background: #fff; color: #1a56db; border: 1rpx solid #1a56db; }

/* ─── Banner ─── */
.banner {
  margin: 20rpx 24rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.banner-item {
  height: 200rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 30rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.banner-tag {
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 12rpx;
  align-self: flex-start;
}
.banner-title { color: #fff; font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.banner-desc { color: rgba(255,255,255,0.85); font-size: 26rpx; }

/* ─── 快捷入口 ─── */
.quick-grid {
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 0;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.quick-icon { font-size: 44rpx; color: #1a56db; }
.quick-label { font-size: 24rpx; color: #333; }

/* ─── Section ─── */
.section { margin: 0 24rpx 24rpx; }
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title { font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.section-more { font-size: 26rpx; color: #1a56db; }

/* ─── 房型卡片 ─── */
.room-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.room-img-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f1f5f9;
  overflow: hidden;
}
.img-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  z-index: 0;
}
.img-placeholder .iconfont { font-size: 44rpx; }
.room-img {
  position: absolute;
  top: 0; left: 0;
  width: 200rpx;
  height: 200rpx;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}
.room-img.loaded { opacity: 1; }
.room-rating {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}
.room-info { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.room-name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 10rpx; }
.room-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.room-footer { display: flex; align-items: center; justify-content: space-between; }
.room-price { font-size: 36rpx; font-weight: 700; color: #ff4d4f; }
.room-unit { font-size: 22rpx; color: #999; }
.room-btn { font-size: 24rpx; padding: 10rpx 20rpx; }

/* ─── Loading ─── */
.loading-wrap { text-align: center; padding: 40rpx; color: #999; font-size: 28rpx; }

/* ─── 日期选择器 ─── */
.modal-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.date-picker-modal {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.picker-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 8rpx; }
.picker-hint { font-size: 26rpx; color: #999; text-align: center; margin-bottom: 16rpx; }
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 2;
}
.months-scroll {
  max-height: 60vh;
  margin-bottom: 16rpx;
}
.month-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 24rpx 0 12rpx;
  text-align: center;
}
.date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 16rpx;
}
.day-header { text-align: center; font-size: 24rpx; color: #999; padding: 8rpx 0; }
.day-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  border-radius: 8rpx;
  min-height: 72rpx;
}
.day-cell.empty { background: transparent; }
.day-cell.past { opacity: 0.3; }
.day-cell.today { background: #e8f0fe; }
.day-cell.selected { background: #1a56db; }
.day-cell.selected .day-num { color: #fff; }
.day-cell.in-range { background: #e8f0fe; }
.day-num { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }
.day-cell.holiday .day-num { color: #ff4d4f; }
.day-label { font-size: 18rpx; color: #999; margin-top: 2rpx; }

.picker-footer { padding-top: 16rpx; }