<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 全屏 loading：始终存在，用 hidden 属性切换（避免 wx:if 导致的 DOM 重建闪烁） -->
  <view class="launch-loading" hidden="{{versionReady}}">
    <view class="launch-loading-icon">
      <view class="dot-bounce" style="animation-delay:0s"></view>
      <view class="dot-bounce" style="animation-delay:0.2s"></view>
      <view class="dot-bounce" style="animation-delay:0.4s"></view>
    </view>
    <text class="launch-loading-text">加载中...</text>
  </view>

  <!-- ─── 搜索头部（非审核模式显示） ─── -->
  <view class="header">
    <view class="header-slogan">寻找你的专属住所 <text class="iconfont icon-bank"></text></view>
    <view class="search-box" bindtap="goRooms" wx:if="{{appVersion !== '0.0.1'}}">
      <text class="iconfont icon-search search-icon"></text>
      <text class="search-placeholder">搜索房型、设施...</text>
    </view>
    <view class="date-chips">
      <view class="date-chip" bindtap="showDatePicker">
        <text class="chip-label">入住</text>
        <text class="chip-date">{{checkInLabel}}</text>
      </view>
      <view class="date-arrow">→</view>
      <view class="date-chip" bindtap="showDatePicker">
        <text class="chip-label">退房</text>
        <text class="chip-date">{{checkOutLabel}}</text>
      </view>
      <view class="nights-badge">{{nights}}晚</view>
    </view>
  </view>

  <scroll-view scroll-y class="content safe-bottom">
    <!-- 欢迎提示 + 酒店位置（始终显示） -->
    <view class="welcome-bar">
      <view class="welcome-top">
        <text class="iconfont icon-notification welcome-icon"></text>
        <text class="welcome-text">欢迎入住{{hotelConfig.hotel_name || '酒店'}}，如需帮助请联系前台</text>
      </view>
      <view class="welcome-bottom" wx:if="{{hotelConfig.hotel_address}}">
        <view class="welcome-address" bindtap="navigateToHotel">
          <text class="iconfont icon-location address-icon"></text>
          <text class="address-text">{{hotelConfig.hotel_address}}</text>
        </view>
        <view class="welcome-actions">
          <view class="welcome-btn nav-btn" bindtap="navigateToHotel">
            <text class="iconfont icon-compass"></text>
            <text>导航</text>
          </view>
          <view class="welcome-btn call-btn" bindtap="callHotel">
            <text class="iconfont icon-phone"></text>
            <text>电话</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 轮播 Banner（非审核模式显示） -->
    <swiper class="banner" autoplay interval="3000" circular indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-item">
          <view class="banner-tag">{{item.tag}}</view>
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-desc">{{item.desc}}</view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 快捷入口（非审核模式显示） -->
    <view class="quick-grid" wx:if="{{appVersion !== '0.0.1'}}">
      <view class="quick-item" bindtap="goRooms">
        <text class="iconfont icon-home quick-icon"></text>
        <text class="quick-label">预订房间</text>
      </view>
      <view class="quick-item" bindtap="goOrders">
        <text class="iconfont icon-file-text quick-icon"></text>
        <text class="quick-label">我的订单</text>
      </view>
      <view class="quick-item" bindtap="goMember">
        <text class="iconfont icon-crown quick-icon"></text>
        <text class="quick-label">会员中心</text>
      </view>
    </view>

    <!-- 热门房型（非审核模式显示） -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">热门推荐</text>
        <text class="section-more" bindtap="goRooms">查看全部 ›</text>
      </view>

      <view wx:if="{{loading}}" class="loading-wrap">
        <view class="loading-text">加载中...</view>
      </view>

      <view wx:else>
        <view class="room-card" wx:for="{{rooms}}" wx:key="id" bindtap="goRoomDetail" data-id="{{item.id}}">
          <view class="room-img-wrap">
            <view class="img-placeholder">
              <text class="iconfont icon-image"></text>
            </view>
            <image
              wx:if="{{item.imageUrl}}"
              class="room-img {{item.imgLoaded ? 'loaded' : ''}}"
              src="{{item.imageUrl}}"
              mode="aspectFill"
              binderror="onImgError"
              bindload="onImgLoad"
              data-id="{{item.id}}"
            />
            <view class="room-rating"><text class="iconfont icon-star-fill"></text> {{item.rating}}</view>
          </view>
          <view class="room-info">
            <view class="room-name">{{item.name}}</view>
            <view class="room-tags">
              <view class="tag tag-blue" wx:if="{{item.area}}"><text class="iconfont icon-border-outer"></text> {{item.area}}㎡</view>
              <view class="tag tag-blue" wx:if="{{item.bedType}}"><text class="iconfont icon-home"></text> {{item.bedType}}</view>
              <text class="tag tag-green" wx:if="{{item.breakfast}}">含早餐</text>
              <text class="tag tag-gray" wx:if="{{item.smokeFree}}">禁烟</text>
            </view>
            <view class="room-footer">
              <view>
                <text class="room-price">¥{{item.price}}</text>
                <text class="room-unit">/晚</text>
              </view>
              <view wx:if="{{appVersion !== '0.0.1'}}" class="btn btn-primary room-btn" catchtap="goBook" data-id="{{item.id}}">立即预订</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 日期选择弹窗 -->
  <view class="modal-mask" wx:if="{{showPicker}}" bindtap="closePicker">
    <view class="date-picker-modal" catchtap="noop">
      <view class="picker-title">选择入住/退房日期</view>
      <view class="picker-hint">
        {{tempCheckIn && !tempCheckOut ? '请选择退房日期' : (tempCheckIn && tempCheckOut ? '已选 ' + tempCheckIn + ' → ' + tempCheckOut : '请选择入住日期')}}
      </view>
      <view class="week-header">
        <view class="day-header" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
      </view>
      <scroll-view scroll-y class="months-scroll">
        <block wx:for="{{calendarMonths}}" wx:key="key" wx:for-item="m">
          <view class="month-title">{{m.title}}</view>
          <view class="date-grid">
            <view
              class="day-cell {{item.type}}"
              wx:for="{{m.days}}"
              wx:key="date"
              wx:for-item="item"
              bindtap="selectDate"
              data-date="{{item.date}}"
            >
              <text class="day-num">{{item.day}}</text>
              <text class="day-label" wx:if="{{item.label}}">{{item.label}}</text>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="picker-footer">
        <view class="btn btn-primary btn-block" bindtap="confirmDates">确定</view>
      </view>
    </view>
  </view>
</view>
