<!-- pages/order_create/order_create.wxml -->
<view class="page">
  <!-- 步骤指示 -->
  <view class="steps">
    <view class="step done">
      <view class="step-circle">✓</view>
      <text class="step-label">选择房型</text>
    </view>
    <view class="step-line done"></view>
    <view class="step active">
      <view class="step-circle">2</view>
      <text class="step-label">填写信息</text>
    </view>
    <view class="step-line"></view>
    <view class="step">
      <view class="step-circle">3</view>
      <text class="step-label">确认支付</text>
    </view>
  </view>

  <scroll-view scroll-y class="content safe-bottom">
    <!-- 房型信息 -->
    <view class="room-summary card">
      <view class="room-thumb-wrap">
        <view class="img-placeholder">
          <text class="iconfont icon-image"></text>
        </view>
        <image
          wx:if="{{room.imageUrl}}"
          class="room-thumb {{thumbLoaded ? 'loaded' : ''}}"
          src="{{room.imageUrl}}"
          mode="aspectFill"
          binderror="onThumbError"
          bindload="onThumbLoad"
        />
      </view>
      <view class="room-info">
        <view class="room-name">{{room.name}}</view>
        <view class="room-desc">{{room.area}}㎡ · {{room.bedType}} · {{room.view || '城市景观'}} {{room.smokeFree?'禁烟':''}} · {{room.breakfast?'含早餐':'不含早餐'}}</view>
      </view>
    </view>

    <!-- 日期选择 -->
    <view class="date-card card">
      <view class="date-item">
        <text class="date-label">入住</text>
        <text class="date-val">{{checkInDisplay}}</text>
      </view>
      <view class="date-sep">
        <view class="arrow-line"></view>
        <view class="nights-dot">{{nights}}晚</view>
      </view>
      <view class="date-item">
        <text class="date-label">退房</text>
        <text class="date-val">{{checkOutDisplay}}</text>
      </view>
    </view>

    <!-- 入住人信息 -->
    <view class="form-card card">
      <view class="form-title">入住人信息</view>
      <block wx:for="{{guests}}" wx:key="index">
        <view class="guest-header" wx:if="{{index > 0}}">
          <text class="guest-label">入住人{{index + 1}}</text>
          <text class="guest-remove" bindtap="removeGuest" data-idx="{{index}}">删除</text>
        </view>
        <view class="form-item">
          <text class="form-label">姓名</text>
          <input class="form-input" value="{{item.name}}" placeholder="请输入入住人姓名" bindinput="onGuestNameInput" data-idx="{{index}}"/>
        </view>
        <view class="divider"></view>
        <view class="form-item">
          <text class="form-label">手机号</text>
          <input class="form-input" value="{{item.phone}}" placeholder="请输入手机号" type="number" maxlength="11" bindinput="onGuestPhoneInput" data-idx="{{index}}"/>
        </view>
        <view class="guest-divider" wx:if="{{index < guests.length - 1}}"></view>
      </block>
      <view class="add-guest-btn" bindtap="addGuest" wx:if="{{guests.length < 5}}">
        <text class="add-guest-icon">+</text>
        <text class="add-guest-text">添加入住人</text>
      </view>
    </view>

    <!-- 房间数量 -->
    <view class="qty-card card">
      <text class="qty-label">房间数量</text>
      <view class="qty-right">
        <text class="qty-remain">（剩余{{room.availableRooms || 5}}间）</text>
        <view class="counter">
          <view class="counter-btn {{qty<=1?'disabled':''}}" bindtap="decreaseQty">-</view>
          <text class="counter-val">{{qty}}</text>
          <view class="counter-btn" bindtap="increaseQty">+</view>
        </view>
      </view>
    </view>

    <!-- 特殊要求 -->
    <view class="remark-card card">
      <view class="form-title">特殊要求（选填）</view>
      <textarea
        class="remark-textarea"
        value="{{remark}}"
        placeholder="如：希望高楼层、安静的房间，提前入住需求等"
        bindinput="onRemarkInput"
        maxlength="200"
      />
      <view class="remark-count">{{remark.length}}/200</view>
    </view>

    <!-- 取消政策 -->
    <view class="policy-card card">
      <view class="policy-icon"><text class="iconfont icon-file-text"></text></view>
      <view class="policy-content">
        <view class="policy-title">取消政策</view>
        <view class="policy-text">入住当日18:00前可免费取消；18:00后取消收取首晚费用的50%。</view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部 -->
  <view class="bottom-bar">
    <view class="total-price">
      <text class="total-label">合计</text>
      <text class="total-val">¥{{totalPrice}}</text>
    </view>
    <view class="btn btn-primary next-btn" bindtap="goNext">下一步</view>
  </view>
</view>
