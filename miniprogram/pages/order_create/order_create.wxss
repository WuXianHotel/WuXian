/* pages/order_create/order_create.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── 步骤 ─── */
.steps {
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  gap: 0;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.step.active .step-circle {
  background: #1a56db;
  color: #fff;
  box-shadow: 0 0 0 6rpx rgba(26,86,219,0.2);
}
.step.done .step-circle {
  background: #1a56db;
  color: #fff;
}
.step-label { font-size: 22rpx; color: #999; }
.step.active .step-label, .step.done .step-label { color: #1a56db; }
.step-line {
  width: 80rpx;
  height: 2rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
  margin-bottom: 24rpx;
}
.step-line.done { background: #1a56db; }

.content { height: calc(100vh - 140px); }

/* ─── 房型摘要 ─── */
.room-summary {
  margin: 20rpx 24rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.room-thumb-wrap {
  position: relative;
  width: 140rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f1f5f9;
  overflow: hidden;
}
.img-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  z-index: 0;
}
.img-placeholder .iconfont { font-size: 36rpx; }
.room-thumb {
  position: absolute;
  top: 0; left: 0;
  width: 140rpx;
  height: 100rpx;
  border-radius: 12rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}
.room-thumb.loaded { opacity: 1; }
.room-name { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.room-desc { font-size: 24rpx; color: #666; line-height: 1.5; }

/* ─── 日期卡 ─── */
.date-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.date-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.date-label { font-size: 24rpx; color: #999; }
.date-val { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.date-sep { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.arrow-line { width: 60rpx; height: 2rpx; background: #e0e0e0; }
.nights-dot {
  background: #e8f0fe;
  color: #1a56db;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* ─── 表单 ─── */
.form-card { margin: 0 24rpx 20rpx; padding: 24rpx; }
.form-title { font-size: 28rpx; font-weight: 700; margin-bottom: 20rpx; }
.form-item { display: flex; align-items: center; padding: 12rpx 0; }
.form-label { font-size: 28rpx; color: #666; width: 120rpx; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; color: #1a1a1a; }
.divider { height: 1rpx; background: #f0f0f0; }

/* ─── 数量 ─── */
.qty-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.qty-label { font-size: 28rpx; font-weight: 600; }
.qty-right { display: flex; align-items: center; gap: 16rpx; }
.qty-remain { font-size: 24rpx; color: #999; }
.counter { display: flex; align-items: center; gap: 0; }
.counter-btn {
  width: 60rpx; height: 60rpx;
  background: #e8f0fe;
  color: #1a56db;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: 700;
}
.counter-btn.disabled { background: #f0f0f0; color: #ccc; }
.counter-val { width: 60rpx; text-align: center; font-size: 32rpx; font-weight: 700; }

/* ─── 备注 ─── */
.remark-card { margin: 0 24rpx 20rpx; padding: 24rpx; }
.remark-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-top: 12rpx;
}
.remark-count { text-align: right; font-size: 22rpx; color: #ccc; margin-top: 8rpx; }

/* ─── 政策 ─── */
.policy-card {
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
  background: #f8f9ff;
}
.policy-icon { font-size: 32rpx; flex-shrink: 0; }
.policy-title { font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.policy-text { font-size: 24rpx; color: #666; line-height: 1.6; }

/* ─── 底部 ─── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f0f0f0;
}
.total-price { display: flex; align-items: baseline; gap: 8rpx; }
.total-label { font-size: 26rpx; color: #666; }
.total-val { font-size: 44rpx; font-weight: 700; color: #ff4d4f; }
.next-btn { font-size: 30rpx; padding: 20rpx 60rpx; }

/* ─── 多入住人 ─── */
.guest-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}
.guest-label { font-size: 26rpx; color: #666; font-weight: 600; }
.guest-remove { font-size: 24rpx; color: #ff4d4f; padding: 4rpx 12rpx; }
.guest-divider { height: 1rpx; background: #e8f0fe; margin: 20rpx 0; }
.add-guest-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0 4rpx;
  margin-top: 16rpx;
  border-top: 1rpx dashed #e0e0e0;
}
.add-guest-icon {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #e8f0fe; color: #1a56db;
  font-size: 32rpx; display: flex; align-items: center; justify-content: center; font-weight: 700;
}
.add-guest-text { font-size: 26rpx; color: #1a56db; font-weight: 500; }
