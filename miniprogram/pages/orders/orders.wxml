<!-- pages/orders/orders.wxml -->
<view class="page">
  <!-- 标签栏 -->
  <scroll-view scroll-x class="tabs-scroll">
    <view class="tabs">
      <view
        class="tab {{activeTab===item.key?'active':''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <scroll-view scroll-y class="order-list safe-bottom" bindscrolltolower="loadMore">
    <view wx:if="{{loading}}" class="loading-wrap">加载中...</view>

    <view wx:elif="{{orders.length === 0}}" class="empty">
      <view class="empty-icon">📋</view>
      <text class="empty-text">暂无订单</text>
    </view>

    <block wx:else>
      <view class="order-card card" wx:for="{{orders}}" wx:key="id">
        <!-- 卡片头 -->
        <view class="card-header">
          <text class="order-no">订单号 {{item.orderNo}}</text>
          <text class="order-status" style="color:{{item.statusColor}}">{{item.statusText}}</text>
        </view>

        <!-- 倒计时 -->
        <view class="countdown-bar" wx:if="{{item.status==='pending_payment' && item.countdown}}">
          ⏰ 支付剩余：{{item.countdown}}，超时自动取消
        </view>

        <!-- 评价提示 -->
        <view class="review-prompt" wx:if="{{item.status==='completed' && !item.hasReview}}">
          ✍️ 感谢您的入住，<text class="review-link" bindtap="goReview" data-id="{{item.id}}">去评价 ›</text>
        </view>

        <!-- 订单内容 -->
        <view class="card-body" bindtap="goDetail" data-id="{{item.id}}">
          <image class="order-img" src="{{item.imageUrl || '/images/room-placeholder.png'}}" mode="aspectFill"/>
          <view class="order-info">
            <view class="order-room-name">{{item.roomName}}</view>
            <view class="order-dates">{{item.checkInLabel}} ~ {{item.checkOutLabel}}</view>
            <view class="order-meta">{{item.guestName}} · {{item.qty}}间 · {{item.nights}}晚</view>
          </view>
        </view>

        <!-- 底部 -->
        <view class="card-footer">
          <text class="order-price">¥{{item.finalPrice}}</text>
          <view class="action-btns">
            <!-- 待支付 -->
            <block wx:if="{{item.status==='pending_payment'}}">
              <view class="btn btn-gray btn-xs" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
              <view class="btn btn-primary btn-xs" bindtap="goPay" data-id="{{item.id}}">去支付</view>
            </block>
            <!-- 待入住 -->
            <block wx:elif="{{item.status==='pending_checkin'}}">
              <view class="btn btn-gray btn-xs" bindtap="goDetail" data-id="{{item.id}}">查看详情</view>
              <view class="btn btn-danger btn-xs" bindtap="cancelOrder" data-id="{{item.id}}">申请取消</view>
            </block>
            <!-- 已完成 -->
            <block wx:elif="{{item.status==='completed'}}">
              <view class="btn btn-gray btn-xs" bindtap="viewInvoice" data-id="{{item.id}}">查看发票</view>
              <view class="btn btn-primary btn-xs" bindtap="goReview" data-id="{{item.id}}">写评价</view>
            </block>
            <!-- 其他 -->
            <block wx:else>
              <view class="btn btn-gray btn-xs" bindtap="goDetail" data-id="{{item.id}}">查看详情</view>
            </block>
          </view>
        </view>
      </view>

      <view wx:if="{{noMore && orders.length > 0}}" class="no-more">没有更多了</view>
    </block>
  </scroll-view>
</view>
