<!-- pages/points_mall/points_mall.wxml -->
<view class="page">
  <!-- 积分余额 -->
  <view class="points-banner">
    <text class="points-label">我的积分</text>
    <text class="points-num">{{memberPoints}}</text>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'products' ? 'active' : ''}}" bindtap="switchTab" data-tab="products">商品列表</view>
    <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">兑换记录</view>
  </view>

  <!-- 商品列表 -->
  <scroll-view wx:if="{{activeTab === 'products'}}" scroll-y class="content safe-bottom">
    <view wx:if="{{loading}}" class="loading-center" style="padding:60rpx"><view class="loading-text">加载中...</view></view>
    <view wx:else class="product-grid">
      <view class="product-card card" wx:for="{{products}}" wx:key="id" bindtap="openExchange" data-item="{{item}}">
        <view class="product-img-wrap">
          <image wx:if="{{item.image}}" class="product-img" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="product-img-placeholder"><text class="iconfont icon-gift"></text></view>
        </view>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="product-footer">
            <text class="product-points">{{item.points_cost}} 积分</text>
            <text class="product-stock" wx:if="{{item.stock < 50}}">剩{{item.stock}}件</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!products.length}}" class="empty-tip">暂无商品</view>
    </view>
  </scroll-view>

  <!-- 兑换记录 -->
  <scroll-view wx:if="{{activeTab === 'records'}}" scroll-y class="content safe-bottom" bindscrolltolower="loadMoreRecords">
    <view wx:if="{{recordsLoading && !records.length}}" class="loading-center" style="padding:60rpx"><view class="loading-text">加载中...</view></view>
    <view wx:else class="records-list">
      <view class="record-item card" wx:for="{{records}}" wx:key="id">
        <view class="record-top">
          <image wx:if="{{item.product_image}}" class="record-img" src="{{item.product_image}}" mode="aspectFill"/>
          <view wx:else class="record-img-placeholder"><text class="iconfont icon-gift"></text></view>
          <view class="record-info">
            <text class="record-name">{{item.product_name}}</text>
            <text class="record-points">-{{item.points_spent}} 积分</text>
          </view>
          <view class="record-status status-{{item.status}}">
            {{item.status === 0 ? '待处理' : item.status === 1 ? '已完成' : '已取消'}}
          </view>
        </view>
        <view class="record-bottom">
          <text class="record-address" wx:if="{{item.receiver}}">{{item.receiver}} {{item.phone}} {{item.address}}</text>
          <text class="record-date">{{item.created_at}}</text>
        </view>
      </view>
      <view wx:if="{{!records.length && !recordsLoading}}" class="empty-tip">暂无兑换记录</view>
      <view wx:if="{{recordsLoading && records.length}}" class="loading-tip">加载中...</view>
      <view wx:if="{{recordsNoMore && records.length}}" class="loading-tip">没有更多了</view>
    </view>
  </scroll-view>

  <!-- 兑换弹窗 -->
  <view class="modal-mask" wx:if="{{showExchange}}" catchtap="closeExchange">
    <view class="exchange-modal" catchtap="preventBubble">
      <view class="modal-title">确认兑换</view>
      <view class="exchange-info">
        <text class="exchange-name">{{exchangeProduct.name}}</text>
        <text class="exchange-cost">消耗 {{exchangeProduct.points_cost}} 积分</text>
      </view>

      <!-- 收货信息 -->
      <view class="form-item" catchtap="preventBubble">
        <text class="form-label">收件人</text>
        <input class="form-input" placeholder="请输入收件人" bindinput="onFormInput" data-field="receiver"/>
      </view>
      <view class="form-item" catchtap="preventBubble">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" bindinput="onFormInput" data-field="phone"/>
      </view>
      <view class="form-item" catchtap="preventBubble">
        <text class="form-label">收货地址</text>
        <input class="form-input" placeholder="请输入详细地址" bindinput="onFormInput" data-field="address"/>
      </view>

      <view class="modal-footer">
        <view class="btn btn-gray" bindtap="closeExchange">取消</view>
        <view class="btn btn-primary {{exchanging?'disabled':''}}" bindtap="doExchange">
          {{exchanging ? '兑换中...' : '确认兑换'}}
        </view>
      </view>
    </view>
  </view>
</view>
