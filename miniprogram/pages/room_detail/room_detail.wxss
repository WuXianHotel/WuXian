/* pages/room_detail/room_detail.wxss */
.page { background: #f7f7f7; }

.hero { position: relative; height: 400rpx; }
.hero-img { width: 100%; height: 400rpx; display: block; }
.hero-overlay {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 40%, transparent 70%, rgba(0,0,0,0.2) 100%);
}
.hero-share {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(0,0,0,0.4);
  color: #fff;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.hero-counter {
  position: absolute;
  bottom: 16rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.content { height: calc(100vh - 200px); }

/* ─── 信息卡 ─── */
.info-card { margin: 20rpx 24rpx; padding: 24rpx; }
.room-name { font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.rating-row { display: flex; align-items: center; gap: 8rpx; margin-bottom: 16rpx; }
.stars { font-size: 24rpx; }
.rating-score { font-size: 32rpx; font-weight: 700; color: #faad14; }
.review-count { font-size: 24rpx; color: #999; }
.attr-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.attr-box {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.attr-icon { font-size: 24rpx; }
.attr-text { font-size: 24rpx; color: #444; }

/* ─── Section ─── */
.section { margin: 0 24rpx 20rpx; padding: 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }
.see-more { font-size: 26rpx; color: #1a56db; }

/* ─── 日历 ─── */
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4rpx; margin-bottom: 16rpx; }
.cal-header { text-align: center; font-size: 22rpx; color: #999; padding: 6rpx 0; }
.cal-cell {
  display: flex; flex-direction: column; align-items: center;
  padding: 8rpx 4rpx; border-radius: 8rpx; min-height: 68rpx;
}
.cal-cell.empty { background: transparent; }
.cal-cell.past { opacity: 0.3; }
.cal-cell.today { background: #e8f0fe; }
.cal-cell.selected { background: #1a56db; }
.cal-cell.selected .cal-day, .cal-cell.selected .cal-price { color: #fff !important; }
.cal-cell.in-range { background: #e8f0fe; }
.cal-day { font-size: 26rpx; color: #1a1a1a; }
.cal-cell.holiday .cal-day { color: #ff4d4f; }
.cal-price { font-size: 18rpx; color: #999; margin-top: 2rpx; }
.cal-cell.holiday .cal-price { color: #ff4d4f; }

.selected-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #e8f0fe;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}
.range-item { color: #1a56db; font-weight: 600; }
.range-sep { color: #999; }
.range-nights { margin-left: auto; background: #1a56db; color: #fff; padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; }

/* ─── 设施 ─── */
.facility-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; }
.facility-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.fac-icon { font-size: 40rpx; }
.fac-name { font-size: 22rpx; color: #555; text-align: center; }

/* ─── 评价 ─── */
.review-summary { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.big-score { font-size: 72rpx; font-weight: 700; color: #faad14; }
.score-bars { flex: 1; display: flex; flex-direction: column; gap: 8rpx; justify-content: center; }
.score-bar-row { display: flex; align-items: center; gap: 8rpx; }
.bar-label { font-size: 22rpx; color: #666; width: 32rpx; }
.bar-track { flex: 1; height: 8rpx; background: #f0f0f0; border-radius: 4rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #faad14; border-radius: 4rpx; }
.bar-pct { font-size: 22rpx; color: #999; width: 50rpx; text-align: right; }

.review-item { padding: 20rpx 0; border-top: 1rpx solid #f0f0f0; }
.review-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.reviewer-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}
.reviewer-info { flex: 1; }
.reviewer-name { font-size: 28rpx; font-weight: 600; }
.reviewer-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.review-stars { font-size: 24rpx; }
.review-text { font-size: 26rpx; color: #444; line-height: 1.6; }

/* ─── 底部栏 ─── */
.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f0f0f0;
}
.bottom-price { display: flex; align-items: baseline; gap: 4rpx; }
.price-label { font-size: 24rpx; color: #999; }
.price-val { font-size: 44rpx; font-weight: 700; color: #ff4d4f; }
.price-unit { font-size: 24rpx; color: #999; }
.book-btn { font-size: 30rpx; padding: 20rpx 60rpx; }
