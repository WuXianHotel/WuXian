/* pages/rooms/rooms.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

.top-bar {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  padding: 20rpx 24rpx 24rpx;
}
.date-summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.date-block {
  flex: 1;
  background: rgba(255,255,255,0.22);
  border-radius: 14rpx;
  padding: 16rpx 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.date-label { color: rgba(255,255,255,0.75); font-size: 22rpx; margin-bottom: 4rpx; }
.date-main { display: flex; align-items: baseline; gap: 10rpx; }
.date-md { color: #fff; font-size: 34rpx; font-weight: 700; line-height: 1.1; }
.date-week { color: rgba(255,255,255,0.85); font-size: 24rpx; }
.date-middle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 0 4rpx;
}
.nights-badge {
  background: #fff;
  color: #1a56db;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.date-arrow { color: rgba(255,255,255,0.85); font-size: 24rpx; line-height: 1; }

.filter-bar {
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-scroll { white-space: nowrap; }
.filter-tabs {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 24rpx;
}
.filter-tab {
  font-size: 28rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}
.filter-tab-icon { font-size: 22rpx; }
.filter-tab.active { color: #1a56db; font-weight: 600; }

.tag-scroll { white-space: nowrap; border-top: 1rpx solid #f0f0f0; }
.tag-row {
  display: inline-flex;
  padding: 12rpx 24rpx;
  gap: 16rpx;
}
.filter-tag {
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.filter-tag.active {
  background: #e8f0fe;
  color: #1a56db;
  font-weight: 600;
}

.result-count {
  padding: 16rpx 24rpx 8rpx;
  font-size: 26rpx;
  color: #999;
}

.list-scroll { height: calc(100vh - 130px); }

/* ─── 房型卡片 ─── */
.room-card {
  margin: 0 24rpx 20rpx;
  overflow: hidden;
}
.img-wrap {
  position: relative;
  height: 240rpx;
  background: #f1f5f9;
  overflow: hidden;
}
.img-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  z-index: 0;
}
.img-placeholder .iconfont { font-size: 56rpx; }
.img-placeholder-text { font-size: 22rpx; color: #94a3b8; }
.room-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 240rpx;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}
.room-img.loaded { opacity: 1; }
.img-label {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.img-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.img-badge.hot { background: #ff4d4f; color: #fff; }
.img-badge.suite { background: #ff7800; color: #fff; }

.info-wrap { padding: 20rpx; }
.room-name { font-size: 32rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 10rpx; }
.room-attrs { display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 24rpx; color: #666; margin-bottom: 10rpx; }
.room-attr-item { display: inline-flex; align-items: center; gap: 4rpx; }
.room-facilities { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.facility { font-size: 24rpx; color: #52c41a; }

.price-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.price-orig { font-size: 24rpx; color: #999; text-decoration: line-through; margin-right: 8rpx; }
.price-now { font-size: 40rpx; font-weight: 700; color: #ff4d4f; }
.price-unit { font-size: 24rpx; color: #999; }
.member-discount {
  font-size: 24rpx;
  background: #fff3e0;
  color: #e65100;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-actions { display: flex; justify-content: flex-end; gap: 16rpx; }
.btn-sm { font-size: 26rpx; padding: 12rpx 28rpx; }
.btn-half { flex: 1; }

/* ─── 无更多 ─── */
.no-more { text-align: center; padding: 32rpx; font-size: 26rpx; color: #ccc; }
.loading-wrap { text-align: center; padding: 40rpx; color: #999; font-size: 28rpx; }

/* ─── 筛选弹窗 ─── */
.modal-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.filter-modal {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
}
.modal-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.filter-section { margin-bottom: 24rpx; }
.filter-label { font-size: 28rpx; color: #666; margin-bottom: 16rpx; }
.price-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.price-opt {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
}
.price-opt.sel { background: #e8f0fe; color: #1a56db; }
.filter-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }

/* ─── 日期选择弹窗 ─── */
.date-picker-modal {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.picker-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 8rpx; }
.picker-hint { font-size: 26rpx; color: #999; text-align: center; margin-bottom: 16rpx; }
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.months-scroll {
  max-height: 60vh;
  margin-bottom: 16rpx;
}
.month-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 24rpx 0 12rpx;
  text-align: center;
}
.date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 16rpx;
}
.day-header { text-align: center; font-size: 24rpx; color: #999; padding: 8rpx 0; }
.day-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  border-radius: 8rpx;
  min-height: 72rpx;
}
.day-cell.empty { background: transparent; }
.day-cell.past { opacity: 0.3; }
.day-cell.today { background: #e8f0fe; }
.day-cell.selected { background: #1a56db; }
.day-cell.selected .day-num { color: #fff; }
.day-cell.in-range { background: #e8f0fe; }
.day-num { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }
.day-label { font-size: 18rpx; color: #fff; margin-top: 2rpx; }
.picker-footer { padding-top: 16rpx; }
