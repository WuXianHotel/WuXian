/* pages/rooms/rooms.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

.top-bar {
  background: #1a56db;
  padding: 16rpx 24rpx 20rpx;
}
.date-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.date-block {
  background: rgba(255,255,255,0.2);
  border-radius: 10rpx;
  padding: 10rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.date-label { color: rgba(255,255,255,0.7); font-size: 22rpx; }
.date-val { color: #fff; font-size: 28rpx; font-weight: 600; }
.nights-badge {
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.filter-bar {
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-scroll { white-space: nowrap; }
.filter-tabs {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 24rpx;
}
.filter-tab {
  font-size: 28rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
.filter-tab.active { color: #1a56db; font-weight: 600; }

.tag-scroll { white-space: nowrap; border-top: 1rpx solid #f0f0f0; }
.tag-row {
  display: inline-flex;
  padding: 12rpx 24rpx;
  gap: 16rpx;
}
.filter-tag {
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.filter-tag.active {
  background: #e8f0fe;
  color: #1a56db;
  font-weight: 600;
}

.result-count {
  padding: 16rpx 24rpx 8rpx;
  font-size: 26rpx;
  color: #999;
}

.list-scroll { height: calc(100vh - 130px); }

/* ─── 房型卡片 ─── */
.room-card {
  margin: 0 24rpx 20rpx;
  overflow: hidden;
}
.img-wrap { position: relative; height: 240rpx; }
.room-img { width: 100%; height: 240rpx; display: block; }
.img-label {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.img-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.img-badge.hot { background: #ff4d4f; color: #fff; }
.img-badge.suite { background: #ff7800; color: #fff; }

.info-wrap { padding: 20rpx; }
.room-name { font-size: 32rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 10rpx; }
.room-attrs { display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 24rpx; color: #666; margin-bottom: 10rpx; }
.room-facilities { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.facility { font-size: 24rpx; color: #52c41a; }

.price-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.price-orig { font-size: 24rpx; color: #999; text-decoration: line-through; margin-right: 8rpx; }
.price-now { font-size: 40rpx; font-weight: 700; color: #ff4d4f; }
.price-unit { font-size: 24rpx; color: #999; }
.member-discount {
  font-size: 24rpx;
  background: #fff3e0;
  color: #e65100;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-actions { display: flex; justify-content: flex-end; gap: 16rpx; }
.btn-sm { font-size: 26rpx; padding: 12rpx 28rpx; }
.btn-half { flex: 1; }

/* ─── 无更多 ─── */
.no-more { text-align: center; padding: 32rpx; font-size: 26rpx; color: #ccc; }
.loading-wrap { text-align: center; padding: 40rpx; color: #999; font-size: 28rpx; }

/* ─── 筛选弹窗 ─── */
.modal-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.filter-modal {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
}
.modal-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.filter-section { margin-bottom: 24rpx; }
.filter-label { font-size: 28rpx; color: #666; margin-bottom: 16rpx; }
.price-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.price-opt {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
}
.price-opt.sel { background: #e8f0fe; color: #1a56db; }
.filter-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
