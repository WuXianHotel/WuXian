/* pages/profile/profile.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── Hero ─── */
.hero {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
/* 头像按钮：重置 button 默认样式 */
.hero-avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  overflow: visible;
  line-height: normal;
  flex-shrink: 0;
  position: relative;
}
.hero-avatar-btn::after { display: none; }
.hero-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  display: block;
}
.hero-avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 4rpx solid rgba(255,255,255,0.5);
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-edit-hint {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}
.hero-info { flex: 1; }
.hero-name { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 8rpx; }
/* 昵称快捷设置输入框 */
.nickname-setup { margin-bottom: 8rpx; }
.nickname-input {
  font-size: 32rpx;
  color: #fff;
  background: rgba(255,255,255,0.15);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  width: 320rpx;
}
.nickname-input::-webkit-input-placeholder { color: rgba(255,255,255,0.6); }
.hero-phone { font-size: 26rpx; color: rgba(255,255,255,0.8); margin-bottom: 8rpx; }
.hero-member {
  display: inline-block;
  background: rgba(255,215,0,0.3);
  color: #ffd700;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.content { height: calc(100vh - 140px); }

/* ─── 菜单组 ─── */
.menu-group {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx 0;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 14rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-label { flex: 1; font-size: 28rpx; color: #1a1a1a; }
.menu-badge {
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 8rpx;
}
.menu-badge-green {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}
.menu-arrow { font-size: 32rpx; color: #ccc; }

/* ─── 退出登录 ─── */
.logout-btn {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx solid #ff4d4f;
  color: #ff4d4f;
  font-size: 30rpx;
  font-weight: 600;
  background: #fff;
}
.login-btn { margin: 24rpx 24rpx; }
