/* pages/profile/profile.wxss */
.page { background: #f7f7f7; min-height: 100vh; }

/* ─── Hero ─── */
.hero {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  padding: 56rpx 32rpx 44rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
}
/* 头像按钮：重置 button 默认样式 */
.hero-avatar-btn {
  width: 128rpx !important;
  height: 128rpx;
  min-width: 0;
  max-width: 128rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  overflow: visible;
  line-height: normal;
  flex-shrink: 0;
  position: relative;
  box-sizing: border-box;
}
.hero-avatar-btn::after { display: none; }
.hero-avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  display: block;
}
.hero-avatar-default {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 4rpx solid rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.9);
}
.hero-avatar-default .iconfont { font-size: 64rpx; }
.avatar-camera {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  color: #1a56db;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.avatar-camera .iconfont { font-size: 22rpx; }

/* 右侧信息区 */
.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.hero-name-row { display: flex; align-items: center; }
.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 昵称快捷设置输入框 */
.nickname-setup { display: inline-block; }
.nickname-input {
  font-size: 32rpx;
  color: #fff;
  background: rgba(255,255,255,0.18);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  width: 320rpx;
}
.nickname-input::-webkit-input-placeholder { color: rgba(255,255,255,0.7); }

.hero-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}
.hero-meta-icon { font-size: 22rpx; }

.hero-badges {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 2rpx;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.hero-badge .iconfont { font-size: 20rpx; }
.level-badge {
  background: rgba(255,215,0,0.25);
  color: #ffd97a;
  border: 1rpx solid rgba(255,215,0,0.4);
}
.points-badge {
  background: rgba(255,255,255,0.22);
  color: #fff;
}

/* 右侧编辑按钮 */
.hero-edit {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 8rpx;
}
.hero-edit .iconfont { color: #fff; font-size: 28rpx; }

.content { height: calc(100vh - 140px); }

/* ─── 菜单组 ─── */
.menu-group {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx 0;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 14rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon .iconfont { font-size: 32rpx; color: #1a56db; }
.menu-label { flex: 1; font-size: 28rpx; color: #1a1a1a; }
.menu-badge {
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 8rpx;
}
.menu-badge-green {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}
.menu-arrow { font-size: 32rpx; color: #ccc; }

/* ─── 登录引导 ─── */
.login-cta {
  margin: 32rpx 24rpx;
  padding: 40rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  text-align: center;
}
.login-cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.login-cta-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
}
.login-btn {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border-radius: 44rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(26,86,219,0.25);
}
.login-btn:active { opacity: 0.85; }
