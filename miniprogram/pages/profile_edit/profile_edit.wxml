<!-- pages/profile_edit/profile_edit.wxml -->
<view class="page">
  <scroll-view scroll-y class="content safe-bottom">
    <!-- 头像 -->
    <view class="section card avatar-section">
      <view class="form-item">
        <text class="form-label">头像</text>
        <button
          class="avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        >
          <image
            wx:if="{{avatarUrl}}"
            class="avatar-img"
            src="{{avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="avatar-placeholder">😊</view>
          <text class="avatar-hint">点击更换</text>
        </button>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section card">
      <view class="section-title">基本信息</view>
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input class="form-input" type="nickname" value="{{form.nickname}}" placeholder="请输入昵称" bindinput="onInput" data-field="nickname"/>
      </view>
      <view class="divider"></view>
      <view class="form-item">
        <text class="form-label">性别</text>
        <radio-group class="radio-group" bindchange="onGenderChange">
          <label class="radio-label"><radio value="1" checked="{{form.gender === 1}}"/>男</label>
          <label class="radio-label"><radio value="2" checked="{{form.gender === 2}}"/>女</label>
          <label class="radio-label"><radio value="0" checked="{{form.gender === 0}}"/>保密</label>
        </radio-group>
      </view>
    </view>

    <!-- 实名信息 -->
    <view class="section card">
      <view class="section-title">实名认证</view>
      <view class="section-hint">实名信息用于入住登记，请确保与证件一致</view>
      <view class="form-item">
        <text class="form-label">真实姓名</text>
        <input class="form-input" value="{{form.realName}}" placeholder="请输入真实姓名" bindinput="onInput" data-field="realName"/>
      </view>
      <view class="divider"></view>
      <view class="form-item">
        <text class="form-label">证件类型</text>
        <picker range="{{idTypes}}" bindchange="onIdTypeChange">
          <view class="picker-value">{{form.idType}} <text class="picker-arrow">&#8250;</text></view>
        </picker>
      </view>
      <view class="divider"></view>
      <view class="form-item">
        <text class="form-label">证件号码</text>
        <input class="form-input" value="{{form.idNumber}}" placeholder="请输入证件号码" bindinput="onInput" data-field="idNumber"/>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="btn btn-primary btn-block save-btn {{saving?'disabled':''}}" bindtap="save">
      {{saving ? '保存中...' : '保存'}}
    </view>
  </scroll-view>
</view>
